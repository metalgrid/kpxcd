post_install() {
	cat <<EOF
==> kpxcd installed.
==>
==> To enable PAM auto-unlock:
==>   1. Add the kpxcd service to your PAM stack (e.g. /etc/pam.d/system-auth):
==>        auth     optional pam_kpxcd.so
==>        session  optional pam_kpxcd.so
==>   2. Enable the user socket:
==>        systemctl --user enable --now kpxcd.socket
==>   3. Run 'kpxcctl setup-default' once to seal your database credential.
==>
==> Example config: /etc/kpxcd/kpxcd.toml.example
EOF
}

post_upgrade() {
	post_install
}
