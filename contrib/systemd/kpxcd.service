[Unit]
Description=KeePassXC Headless Daemon
Documentation=man:kpxcd(8)
Wants=kpxcd.socket
After=kpxcd.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/kpxcd
Restart=on-failure
RestartSec=5

# Credential loading — uncomment and adjust paths as needed:
# LoadCredential=kpxcd-personal:/home/user/.local/share/kpxcd/personal.pass
# LoadCredential=kpxcd-work:/home/user/.local/share/kpxcd/work.pass

# Security hardening
NoNewPrivileges=true
UMask=0077
LimitMEMLOCK=infinity
IPAddressDeny=any
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
Also=kpxcd.socket
