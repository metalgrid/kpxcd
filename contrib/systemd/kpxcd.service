[Unit]
Description=KeePassXC Headless Daemon
Documentation=man:kpxcd(8)
Wants=kpxcd.socket
After=kpxcd.socket

[Service]
Type=simple
ExecStart=/usr/local/bin/kpxcd
Restart=on-failure
RestartSec=5

# Credential loading — uncomment and adjust paths as needed:
# LoadCredential=kpxcd-personal:/home/user/.local/share/kpxcd/personal.pass
# LoadCredential=kpxcd-work:/home/user/.local/share/kpxcd/work.pass

# Security hardening
NoNewPrivileges=true
UMask=0077
LimitMEMLOCK=infinity
IPAddressDeny=any
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
# NOTE: PrivateDevices=true cannot be used here — it hides /dev/uhid
# behind an empty private /dev and DeviceAllow does not materialize
# nodes inside it. The daemon needs the real uhid node to create the
# virtual authenticator. (Access control happens via the udev rule:
# contrib/udev/70-kpxcd-fido2.rules scopes /dev/uhid to seated users.)
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
Also=kpxcd.socket
