# config.toml — Example Configuration
#
# kpxcd creates ~/.config/kpxcd/config.toml from embedded defaults on first run.
# Copy this file there if you want a fuller annotated example.
# Run: kpxcd --config ~/.config/kpxcd/config.toml
#
# Path expansion:
#   ~           expands to your home directory
#   $HOME       expands to HOME environment variable
#   $XDG_*      expands to any XDG environment variable
#   relative/   resolves against $XDG_CONFIG_HOME/kpxcd/
#   /absolute   used as-is
#
# See kpxcd.toml(5) for full documentation of every option.

[daemon]
# Lock databases after 15 minutes of inactivity.
# Set to 0 to disable auto-lock on idle.
idle_timeout = 900

# Parsed but not wired yet: screen-lock auto-lock is not implemented.
lock_on_screenlock = false

# Log level: "error", "warn", "info", "debug"
log_level = "info"

# Send logs to journald when running under systemd.
log_to_journald = true

# SSH agent socket path, relative to $XDG_RUNTIME_DIR.
ssh_socket_path = "kpxcd/ssh.sock"

# "agent" — kpxcd acts as the SSH agent itself.
# "proxy" — kpxcd forwards to the existing SSH_AUTH_SOCK.
ssh_mode = "agent"

# ──────────────────────────────────────────────────────────────
# Database: default local password vault
# ──────────────────────────────────────────────────────────────

[[database]]
path = "$XDG_DATA_HOME/kpxcd/default.kdbx"
name = "Default"
default = true

# Auto-unlock on session start using a PAM login token.
auto_unlock = true

# How to get the password for auto-unlock.
#   "pam"                — unwrap age-sealed credential with PAM login token
#   "systemd-credential" — read from $CREDENTIALS_DIRECTORY
#   "keyfile"            — read a keyfile from disk
#   "prompt"             — don't auto-unlock; wait for kpxcctl unlock
#   "none"               — database has no password (dangerous)
unlock_credential = "pam"

# Parsed but not enforced yet; SSH key auto-add is currently controlled globally.
ssh_auto_add = false

# ──────────────────────────────────────────────────────────────
# Database: work vault (only unlocked manually)
# ──────────────────────────────────────────────────────────────

#[[database]]
#path = "~/Work.kdbx"
#name = "Work"
#auto_unlock = false
#unlock_credential = "prompt"
#ssh_auto_add = false

# ──────────────────────────────────────────────────────────────
# Database: keyfile-only vault (no password)
# ──────────────────────────────────────────────────────────────

#[[database]]
#path = "~/Keys.kdbx"
#name = "Keys"
#auto_unlock = true
#unlock_credential = "keyfile"
#keyfile = "/home/USER/.config/kpxcd/keys.kdbx.key"
#ssh_auto_add = false

# ──────────────────────────────────────────────────────────────
# Secret Service (org.freedesktop.secrets)
#
# When enabled, kpxcd follows the GNOME Keyring/libsecret trust model:
# any same-user application in the unlocked login session can retrieve
# exposed secrets unless require_confirmation=true. This includes:
#   - git-credential-libsecret
#   - Python keyring
#   - nm-applet (WiFi passwords)
#   - seahorse (password manager GUI)
# ──────────────────────────────────────────────────────────────

[secret_service]
enabled = true

# Show a desktop notification each time a password is retrieved.
# This provides visibility into which applications are accessing your vault.
notify_on_access = true

# Seconds to suppress repeat access notifications from the same app.
# The first access notifies; further accesses within this window are
# silent and refresh the timer. 0 = notify on every access.
notify_cache_ttl = 300

# Require Polkit confirmation before returning a password.
# Setting this to true means every password retrieval requires
# you to click "Authorize" in a dialog. If Polkit is unavailable or
# caller metadata cannot be resolved, access is denied.
require_confirmation = false

# Seconds before the confirmation dialog auto-dismisses (0 = no timeout).
confirmation_timeout = 30

# ──────────────────────────────────────────────────────────────
# SSH Agent
#
# When enabled, kpxcd listens on $XDG_RUNTIME_DIR/kpxcd/ssh.sock
# and serves SSH keys from your KeePass entries that have KeeAgent
# settings configured.  Set environment variable:
#   export SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/kpxcd/ssh.sock
# ──────────────────────────────────────────────────────────────

[ssh_agent]
enabled = true

# Remove SSH keys from the agent when their database is locked.
# This ensures keys don't linger after you lock the vault.
remove_on_lock = true

# Parsed/stored but not enforced by kpxcd's built-in SSH agent yet.
confirm_on_use = false

# Parsed/stored but not enforced by kpxcd's built-in SSH agent yet.
lifetime = 0

# Security key provider for sk-ssh-ed25519@openssh.com keys.
# "internal" uses the built-in Go SSH implementation.
security_key_provider = "internal"

# ──────────────────────────────────────────────────────────────
# FIDO2 / Passkeys
#
# Experimental: credential creation plumbing exists, but database
# storage and assertion signing are incomplete.
# The D-Bus/CLI passkey methods currently return not implemented.
# ──────────────────────────────────────────────────────────────

[fido2]
enabled = false

# AAGUID identifies this authenticator in attestation objects.
# This is the same AAGUID KeePassXC uses for software passkeys.
aaguid = "f8a011f3-8c0a-4d15-8006-17111f9edc7d"

# Supported COSE algorithms:
#   -7  = ES256  (ECDSA P-256 with SHA-256)  — universally supported
#   -8  = EdDSA  (Ed25519)                   — fast, modern
#   -25 = ES256K (secp256k1 + SHA-256)       — Bitcoin/Ethereum
#   -37 = PS256  (RSA-PSS with SHA-256)       — legacy RSA
algorithms = [-7, -8]

# Reserved user verification preference for future passkey operations.
#   "required"    — always require user verification (PIN, biometric)
#   "preferred"   — request verification but allow without
#   "discouraged"  — never request verification
user_verification = "preferred"