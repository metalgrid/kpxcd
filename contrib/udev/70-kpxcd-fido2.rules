# kpxcd virtual FIDO2 authenticator — udev access rules.
# The daemon (user service) opens /dev/uhid to create the device; the
# browser needs rw on the resulting hidraw node. Both grants are seat-
# scoped via uaccess and apply to the logged-in user only.

# NOTE: uhid-created HID devices carry no idVendor/idProduct attributes,
# so the virtual hidraw nodes can only be matched by their devpath: they
# always live under /devices/virtual/misc/uhid/.
SUBSYSTEM=="hidraw", KERNELS=="*misc/uhid*", TAG+="uaccess"

# Allow the user session to create virtual HID devices at all.
KERNEL=="uhid", TAG+="uaccess"
