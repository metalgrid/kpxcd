<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <!-- Only actions the daemon actually checks are declared; unenforced
       auth_self entries would promise protection the code does not provide. -->
  <vendor>kpxcd</vendor>
  <vendor_url>https://github.com/metalgrid/kpxcd</vendor_url>

  <action id="org.keepassxc.daemon.get-entry.secret">
    <description>Retrieve a Secret Service secret from kpxcd</description>
    <message>Authentication is required to retrieve a Secret Service secret from kpxcd</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
  </action>

  <action id="org.keepassxc.daemon.passkey.create">
    <description>Create a passkey in kpxcd</description>
    <message>Authentication is required to create a passkey in kpxcd</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>

  <action id="org.keepassxc.daemon.ssh.export">
    <description>Export an SSH private key from kpxcd</description>
    <message>Authentication is required to export an SSH private key</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>

  <action id="org.keepassxc.daemon.passkey.assert">
    <description>Authenticate with a passkey from kpxcd</description>
    <message>Authentication is required to authenticate with a passkey from kpxcd</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
